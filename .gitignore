# Virtual env
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Outputs: outputs/<model>/<step>/ keeps only what the site and the ladder need
# (selected model, result, benchmark drives, NEAT config). Checkpoints and logs stay local.
outputs/*
!outputs/neat/
!outputs/ppo/
outputs/neat/*/*
outputs/ppo/*/*
!outputs/*/*/model.pkl
!outputs/*/*/model.zip
!outputs/*/*/result.json
!outputs/*/*/drives.json
!outputs/*/*/lap.gif
!outputs/*/*/model_*.pkl
!outputs/*/*/model_*.zip
!outputs/*/*/drives_*.json
!outputs/*/*/lap_*.gif
!outputs/*/*/exhibition_*.json
!outputs/neat/*/neat.cfg
outputs/*/dev/

# Editor/OS cruft
.DS_Store
.idea/
.vscode/
*.swp
*.swo
