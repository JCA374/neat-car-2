# Virtual env
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Outputs/checkpoints/logs/plots (but keep analysis/)
# Ignore all checkpoint files in all checkpoint directories...
outputs/checkpoints*/*
# ...except best and latest models
!outputs/checkpoints*/*best*.zip
!outputs/checkpoints*/*latest*.zip

# Ignore all log files in all log directories
outputs/logs*/

# Ignore plots and test artefacts
outputs/plots/
outputs/*_test/
.pytest_cache/

# Editor/OS cruft
.DS_Store
.idea/
.vscode/
*.swp
*.swo
